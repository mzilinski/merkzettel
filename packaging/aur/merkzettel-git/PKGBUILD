# Maintainer: Malte Zilinski <malte at zilinski dot eu>
#
# Development snapshot from the main branch. See the merkzettel package for
# the meaning of _clientid / MERKZETTEL_CLIENT_ID.
pkgname=merkzettel-git
pkgver=0.4.0.r0.g0000000
pkgrel=1
pkgdesc='Native Plasma client for Microsoft To Do (development version)'
arch=('x86_64' 'aarch64')
url='https://mzilinski.github.io/merkzettel/'
license=('GPL-3.0-or-later')
depends=(
  'glibc' 'libstdc++' 'hicolor-icon-theme'
  'qt6-base' 'qt6-declarative' 'qt6-networkauth'
  # QML runtime imports (not visible to namcap's ELF scan)
  'kirigami' 'kirigami-addons' 'qqc2-desktop-style'
  'kcolorscheme' 'kconfig' 'kcoreaddons' 'kdbusaddons' 'kglobalaccel' 'ki18n'
  'knotifications' 'kstatusnotifieritem' 'qtkeychain-qt6'
)
makedepends=('cmake' 'extra-cmake-modules' 'git' 'ninja')
checkdepends=('appstream')
provides=('merkzettel')
conflicts=('merkzettel')
source=('git+https://github.com/mzilinski/merkzettel.git')
sha256sums=('SKIP')
_clientid=

pkgver() {
  cd merkzettel
  local version
  version=$(sed -n 's/^project(merkzettel VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -B build -S merkzettel -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMERKZETTEL_CLIENT_ID="${MERKZETTEL_CLIENT_ID:-$_clientid}" \
    -DMERKZETTEL_TENANT=common
  cmake --build build
}

# The QML smoke test needs a full Kirigami runtime and D-Bus session; the
# unit tests cover the logic.
check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -E tst_appdemo
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
